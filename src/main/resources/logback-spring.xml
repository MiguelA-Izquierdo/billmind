<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Spring Boot defaults: registers %clr / %wEx converters and the standard log properties. -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- PII scrubbing: %pii(...) redacts the rendered message before it reaches the appender. -->
    <conversionRule conversionWord="pii"
                    class="dev.izquierdo.billmind._shared.infrastructure.logging.PiiRedactingMessageConverter"/>

    <!-- Mirrors Boot's default console pattern, with %pii replacing %m as the message converter. -->
    <property name="CONSOLE_PII_PATTERN"
              value="%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}}){faded} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faded} %clr([%15.15t]){faded} %clr(%-40.40logger{39}){cyan} %clr(:){faded} %pii%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PII_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET:-UTF-8}</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>