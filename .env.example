# Servidor
SERVER_PORT=8082
# Puerto de gestión interno para Actuator (separado del puerto de aplicación,
# no se publica de cara al exterior). Apunta aquí los probes de liveness/readiness.
MANAGEMENT_PORT=8083

# Base de Datos
DB_URL=jdbc:postgresql://localhost:5432/billmind
DB_HOST=localhost
DB_PORT=5432
DB_NAME=billmind
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

DDL_AUTO=update

# LLM Provider — ollama (default) | openai | anthropic | gemini | groq
LLM_PROVIDER=ollama

# Ollama (local — activo cuando LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=240

# OpenAI — activo cuando LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Anthropic — activo cuando LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini — activo cuando LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# Groq — activo cuando LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Modelo por rol — opcional, válido para cualquier proveedor.
# Sin definir, ambos roles usan el modelo del proveedor activo.
#   fast  = clasificación + extracción de empresa + redacción PII (una llamada por subida)
#   smart = extracción de campos (JSON estricto) + RAG + bucle agéntico (requiere tool calling)
# LLM_ROLE_FAST_MODEL=openai/gpt-oss-20b
# LLM_ROLE_SMART_MODEL=openai/gpt-oss-120b

# Embedding Model — allminilm (default, local) | openai | ollama
EMBEDDING_PROVIDER=allminilm
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # active when EMBEDDING_PROVIDER=openai (1536d)
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text          # active when EMBEDDING_PROVIDER=ollama (768d)
# OLLAMA_EMBEDDING_MODEL=bge-m3                    # active when EMBEDDING_PROVIDER=ollama (1024d, multilingual, recommended for Spanish)
# OLLAMA_EMBEDDING_TIMEOUT_SECONDS=240             # increase if seed times out on large documents

# Vector Store (PgVector)
# IMPORTANT: PGVECTOR_DIMENSIONS must match the embedding model output:
#   allminilm                      → 384
#   openai text-embedding-3-small  → 1536
#   openai text-embedding-3-large  → 3072
#   ollama nomic-embed-text        → 768
#   ollama bge-m3                  → 1024
# Changing model requires clearing vector_store and re-ingesting all documents.
PGVECTOR_TABLE_NAME=vector_store
PGVECTOR_DIMENSIONS=384
# The IVFFlat index is managed automatically by the app (JpaKnowledgeRepository.rebuildIndex,
# lists=sqrt(rows), skipped below 100 vectors) — no index env vars to set.

# Knowledge Base
# KNOWLEDGE_SEARCH_MIN_VECTOR_SCORE: minimum cosine similarity for vector candidates (0–1).
# Lower = more recall, higher = more precision. Recommended values per model:
#   allminilm              → 0.50  (English-first model, lower scores for Spanish)
#   ollama nomic-embed-text → 0.60
#   ollama bge-m3          → 0.72  (high-quality multilingual, scores typically 0.75+ for related content)
#   openai                 → 0.75
# KNOWLEDGE_SEARCH_MIN_VECTOR_SCORE=0.72
# KNOWLEDGE_SEARCH_MAX_RESULTS=5
# Seed the 5 regulatory documents at startup (set false if the corpus is already populated).
# KNOWLEDGE_SEED_ENABLED=true
# Ingestion sliding window (words). Tuned to AllMiniLM-L6-v2's 256-token limit.
# KNOWLEDGE_CHUNK_SIZE=150
# KNOWLEDGE_CHUNK_OVERLAP=30

# Comparison
# Serve 6 example 2.0TD offers while electricity_rates is empty, so the savings comparison works
# on a fresh clone with no Kafka producer. Read-only — nothing is written to the database, so
# there is nothing to clean up: real rates arriving via Kafka take over automatically.
# COMPARISON_FALLBACK_OFFERS_ENABLED=true

# Kafka
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICAS=1
# Uncomment and set for authenticated brokers (e.g. Confluent Cloud, MSK)
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="your_user" password="your_password";

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8082

# Servicio externo de autenticación — URL base del microservicio que expone GET /introspect
AUTH_EXTERNAL_URL=http://localhost:8081

# Rate limiting — per-endpoint token buckets (bucket4j + Caffeine). See docs/RATELIMIT.md.
# The application.properties defaults are a sensible starting point; uncomment to tune.
# Bucket backend: caffeine (per-instance, Phase 1) | redis (shared across instances, Milestone 9)
# RATELIMIT_STORE=caffeine
# Trust X-Forwarded-For for the client IP. Enable ONLY behind a trusted proxy that overwrites it;
# otherwise the header is attacker-spoofable and the IP ceiling can be bypassed.
# RATELIMIT_TRUST_FORWARDED_FOR=false
# Caffeine bounds: max distinct keys held, and how long an idle bucket survives.
# RATELIMIT_CAFFEINE_MAX_SIZE=50000
# RATELIMIT_CAFFEINE_EXPIRE_AFTER=PT1H
# Per-profile buckets (capacity / refill / period / cost). UPLOAD, CHAT and DEFAULT add an IP ceiling
# (overrides.ip.*) because X-Session-Id is self-asserted. Full variable list in docs/CONFIGURATION.md.
# RATELIMIT_UPLOAD_CAPACITY=15
# RATELIMIT_UPLOAD_IP_CAPACITY=30
# RATELIMIT_CHAT_CAPACITY=20
# RATELIMIT_CHAT_IP_CAPACITY=60
# RATELIMIT_ADMIN_CAPACITY=5
