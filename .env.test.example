# Servidor
SERVER_PORT=8082

# Base de Datos (test)
DB_URL=jdbc:postgresql://localhost:5432/billmind_test
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# LLM Provider — ollama (default) | openai | anthropic | gemini | groq
LLM_PROVIDER=ollama

# Ollama (local — activo cuando LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3

# Vector Store (PgVector)
PGVECTOR_TABLE_NAME=vector_store
PGVECTOR_DIMENSIONS=384
PGVECTOR_INDEX_TYPE=HNSW

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:8080,http://localhost:8082

# JWT
JWT_SECRET=your_super_secret_key_min_32_chars
JWT_EXPIRATION=86400000
